# SearchCenter Live Environment Configuration
# This file contains all environment variables for the SearchCenter Live platform

# ===========================================
# AUTHENTICATION & USER MANAGEMENT
# ===========================================
# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
VITE_CLERK_SECRET_KEY=your_clerk_secret_key_here

# Admin Configuration
VITE_ADMIN_EMAIL=msnithin84@gmail.com
VITE_ADMIN_NAME=Admin
VITE_ADMIN_ROLE=super_admin

# ===========================================
# API SERVICES & EXTERNAL INTEGRATIONS
# ===========================================
# Search APIs
VITE_GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
VITE_GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here
VITE_PERPLEXITY_API_KEY=your_perplexity_api_key_here
VITE_BING_SEARCH_API_KEY=your_bing_search_api_key_here

# GitHub Integration
VITE_GITHUB_TOKEN=your_github_personal_access_token_here
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# YouTube Data API
VITE_YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Kaggle API
VITE_KAGGLE_USERNAME=your_kaggle_username_here
VITE_KAGGLE_KEY=your_kaggle_api_key_here

# Semantic Scholar API
VITE_SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# ===========================================
# AI & ML SERVICES
# ===========================================
# Google Gemini AI
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional - for additional AI features)
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-4

# ===========================================
# DATABASE & STORAGE
# ===========================================
# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MongoDB Configuration
VITE_MONGODB_URI=your_mongodb_connection_string_here
VITE_MONGODB_DB_NAME=searchcenter_live

# Redis Cache (Optional - for performance)
VITE_REDIS_URL=your_redis_connection_string_here
VITE_REDIS_PASSWORD=your_redis_password_here

# ===========================================
# PAYMENT & SUBSCRIPTIONS
# ===========================================
# Razorpay Payment Gateway
VITE_RAZORPAY_KEY=your_razorpay_key_id_here
VITE_RAZORPAY_SECRET=your_razorpay_key_secret_here
VITE_RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Subscription Plans Configuration
VITE_PRO_PLAN_PRICE_MONTHLY=39
VITE_PRO_PLAN_PRICE_YEARLY=399
VITE_ULTRA_PLAN_PRICE_MONTHLY=99
VITE_ULTRA_PLAN_PRICE_YEARLY=999

# ===========================================
# NOTIFICATION & COMMUNICATION
# ===========================================
# Email Service (EmailJS)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# SMTP Configuration (Alternative to EmailJS)
VITE_SMTP_HOST=your_smtp_host_here
VITE_SMTP_PORT=587
VITE_SMTP_USER=your_smtp_username_here
VITE_SMTP_PASS=your_smtp_password_here

# ===========================================
# FILE STORAGE & CDN
# ===========================================
# AWS S3 Configuration
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
VITE_AWS_REGION=us-east-1
VITE_AWS_S3_BUCKET=searchcenter-live-files
VITE_AWS_CDN_URL=https://your-cdn-url.cloudfront.net

# Cloudinary (Alternative to AWS)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key_here
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Google Analytics
VITE_GA_MEASUREMENT_ID=your_google_analytics_measurement_id_here

# Sentry Error Tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# LogRocket Session Recording
VITE_LOGROCKET_APP_ID=your_logrocket_app_id_here

# ===========================================
# SECURITY & RATE LIMITING
# ===========================================
# JWT Configuration
VITE_JWT_SECRET=your_jwt_secret_key_here
VITE_JWT_EXPIRES_IN=7d

# Rate Limiting
VITE_RATE_LIMIT_WINDOW_MS=900000
VITE_RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
VITE_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ===========================================
# SEARCH & CONTENT CONFIGURATION
# ===========================================
# Search Settings
VITE_DEFAULT_SEARCH_LIMIT=20
VITE_MAX_SEARCH_LIMIT=100
VITE_SEARCH_CACHE_TTL=300

# Content Preferences
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh,hi,ta,te

# ===========================================
# DEVELOPMENT & DEPLOYMENT
# ===========================================
# Application URLs
VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001/api
VITE_BACKEND_URL=http://localhost:3001

# Deployment Configuration
VITE_NODE_ENV=development
VITE_LOG_LEVEL=debug
VITE_PORT=5173

# ===========================================
# SOCIAL INTEGRATION
# ===========================================
# Google OAuth
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here

# GitHub OAuth
VITE_GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here

# Microsoft OAuth
VITE_MICROSOFT_OAUTH_CLIENT_ID=your_microsoft_oauth_client_id_here

# ===========================================
# VERIFICATION & SECURITY
# ===========================================
# reCAPTCHA
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Email Verification
VITE_EMAIL_VERIFICATION_REQUIRED=true
VITE_EMAIL_VERIFICATION_TOKEN_EXPIRES=24h

# ===========================================
# FEATURE FLAGS
# ===========================================
# Feature Toggles
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ADVANCED_SEARCH=true
VITE_ENABLE_SOCIAL_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_SUBSCRIPTIONS=true
VITE_ENABLE_ADMIN_PANEL=true

# Beta Features
VITE_ENABLE_BETA_FEATURES=false
VITE_ENABLE_EXPERIMENTAL_AI=false